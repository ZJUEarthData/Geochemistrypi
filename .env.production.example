# Copy to .env.production on the ECS server. Do not commit the real file.
COMPOSE_PROJECT_NAME=geochemistrypi

# Use: git rev-parse --short=12 HEAD
GEOCHEMISTRYPI_SOURCE_REVISION=replace-with-git-revision
GEOCHEMISTRYPI_BUILD_ID=replace-with-release-id
GEOCHEMISTRYPI_ONLINE_INSTANCE_ID=online-production

# Same-origin Nginx proxy does not require CORS. Add comma-separated HTTPS origins only if needed.
GEOCHEMISTRYPI_ALLOWED_ORIGINS=
GEOCHEMISTRYPI_ENABLE_API_DOCS=false

# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

COMPUTE_THREADS=2
BACKEND_CPU_LIMIT=3.0
BACKEND_MEMORY_LIMIT=6g
WEB_CPU_LIMIT=0.5
WEB_MEMORY_LIMIT=256m

# Required only when docker-compose.https.yml is enabled.
TLS_CERT_PATH=/srv/geochemistrypi/certs/fullchain.pem
TLS_KEY_PATH=/srv/geochemistrypi/certs/privkey.pem
