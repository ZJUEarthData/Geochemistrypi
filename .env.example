# Copy this file to .env for local development. Never commit the real .env file.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
SQLALCHEMY_DATABASE_URL=sqlite:///./sql_app.db
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Online API production configuration
GEOCHEMISTRYPI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GEOCHEMISTRYPI_RUNTIME_DIR=./runtime
GEOCHEMISTRYPI_ENABLE_API_DOCS=true
